# Porta onde o servidor Express vai rodar
PORT=3005

# Define o ambiente (development ou production)
NODE_ENV=development

# Uma chave secreta longa e aleatória para assinar os tokens JWT
# IMPORTANTE: Nunca compartilhe esta chave e não envie este arquivo para o GitHub
JWT_SECRET=chave_secreta_longa_e_aleatoria_com_letras_e_numeros_@12938!@#

# URL do seu frontend Next.js (utilizada na configuração do CORS)
FRONTEND_URL=http://localhost:3000

# Se você for usar banco de dados mais para frente, adicione a string de conexão aqui
# Exemplo (MongoDB): 
DATABASE_URL=mongodb://127.0.0.1:27017/dbProgWeb